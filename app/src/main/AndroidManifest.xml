<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La pantalla interna del escáner de ML Kit (GmsBarcodeScanningDelegateActivity) viene
         fijada en vertical, y de eso Play deduce que la app exige pantalla vertical: la escondía de
         Chromebooks y de los dispositivos que solo usan horizontal. La app funciona en las dos
         orientaciones; el escáner, donde no haya vertical, se muestra con bandas. -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />

    <application
        android:name=".TallerApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TallerApp">

        <!-- Descarga el módulo del escáner al instalar, en vez de la primera vez que se usa. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TallerApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte los reportes generados (PDF/CSV) de forma segura. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
